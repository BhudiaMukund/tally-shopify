# Copy to .env.local and fill in. Never commit a filled-in copy — .env* is gitignored.
# Every key here is required at boot; src/lib/env.ts reports all missing ones at once.

# app
APP_URL=https://tally.example.com
AUTH_SECRET=
NODE_ENV=development

# mongo (single-node replica set! transactions and change streams need one)
# This is the docker-compose.dev.yml stack, which runs without auth on a port
# bound to your own machine. Production adds credentials and authSource=admin.
MONGODB_URI=mongodb://localhost:27017/tally?replicaSet=rs0

# queue
REDIS_URL=redis://localhost:6379

# object storage
# The keys below are MinIO's own defaults and match docker-compose.dev.yml.
# They are not a secret and they are not what the deploy uses.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/tally
S3_BUCKET=tally
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Both IDs are printed by `pnpm shopify:doctor` (lands in commit 5).
SHOPIFY_LOCATION_ID=gid://shopify/Location/<id>
SHOPIFY_POS_PUBLICATION_ID=gid://shopify/Publication/<id>
SHOPIFY_WEBHOOK_SECRET=

# ai — only the selected provider's key is required
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_PROMPT_VERSION=1
