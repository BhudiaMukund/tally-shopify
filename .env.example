# Copy to .env.local and fill in. Never commit a filled-in copy — .env* is gitignored.
# Every key here is required at boot; src/lib/env.ts reports all missing ones at once.

# app
# Also where Shopify delivers webhooks, at /api/webhooks/shopify. Must be an
# https URL Shopify can reach — `pnpm shopify:doctor --register` points the four
# subscriptions at it.
APP_URL=https://tally.example.com
AUTH_SECRET=
NODE_ENV=development

# mongo — standalone, matching the deploy. Nothing here uses transactions or
# change streams, so the local stack must not offer them either.
# This is the docker-compose.dev.yml stack, which runs without auth on a port
# bound to your own machine. Production adds credentials and authSource=admin.
MONGODB_URI=mongodb://localhost:27017/tally

# queue
REDIS_URL=redis://localhost:6379

# object storage
# The keys below are MinIO's own defaults and match docker-compose.dev.yml.
# They are not a secret and they are not what the deploy uses.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/tally
S3_BUCKET=tally
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# From the Shopify Dev Dashboard app. Used only by `pnpm shopify:install`,
# which prints the admin token below. The app itself never reads them.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Printed by `pnpm shopify:install`. Starts shpat_.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Both IDs are printed by `pnpm shopify:doctor` (lands in commit 5).
SHOPIFY_LOCATION_ID=gid://shopify/Location/<id>
SHOPIFY_POS_PUBLICATION_ID=gid://shopify/Publication/<id>
# The same shpss_ value as SHOPIFY_API_SECRET — Shopify signs webhook bodies
# with the app's client secret. Named separately because the running app needs
# this one and nothing else from the OAuth pair.
SHOPIFY_WEBHOOK_SECRET=

# ai — only the selected provider's key is required
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_PROMPT_VERSION=1
